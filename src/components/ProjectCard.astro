---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; eager?: boolean }
const { project, eager = false } = Astro.props;
const { title, category, year, hero, heroAlt } = project.data;
---
<a class="card" href={`/projects/${project.id}`}>
  <div class="frame">
    <Image
      src={hero}
      alt={heroAlt}
      widths={[480, 800, 1200]}
      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      loading={eager ? 'eager' : 'lazy'}
    />
  </div>
  <div class="meta"><strong>{title}</strong><span>{category} · {year}</span></div>
</a>
