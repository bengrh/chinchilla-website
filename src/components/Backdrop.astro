---
// Site-wide backdrop from the original site: a parallax dot grid that drifts upward and parts
// around the pointer, and the 32px difference-blend cursor that grows over links. Pointer-only;
// touch devices get neither.
---
<canvas id="dotGrid" aria-hidden="true"></canvas>
<div class="cursor" aria-hidden="true"></div>

<script is:inline>
  (function () {
    var fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    // Dot grid
    var canvas = document.getElementById('dotGrid');
    if (canvas && canvas.getContext) {
      var ctx = canvas.getContext('2d');
      var SP = 28, R = 1.2, OP = 0.12, PAR = 0.15, DRIFT = 12, REPEL = 130, FORCE = 45;
      var w, h, sy = 0, drift = 0, last = null;
      var mx = -9999, my = -9999, cx = -9999, cy = -9999;
      document.addEventListener('mousemove', function (e) { mx = e.clientX; my = e.clientY; });
      window.addEventListener('scroll', function () { sy = window.scrollY; }, { passive: true });
      function resize() {
        var dpr = window.devicePixelRatio || 1;
        w = window.innerWidth; h = window.innerHeight;
        canvas.width = w * dpr; canvas.height = h * dpr;
        canvas.style.width = w + 'px'; canvas.style.height = h + 'px';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      function draw(t) {
        if (last === null) last = t;
        var dt = Math.min((t - last) / 1000, 0.05); last = t;
        drift = (drift + DRIFT * dt) % SP;
        cx += (mx - cx) * 0.12; cy += (my - cy) * 0.12;
        ctx.clearRect(0, 0, w, h);
        var off = (-(sy * PAR) - drift) % SP;
        ctx.fillStyle = 'rgba(255,255,255,' + OP + ')';
        ctx.beginPath();
        var r2 = REPEL * REPEL;
        for (var gx = -SP; gx < w + SP; gx += SP) {
          for (var gy = off - SP; gy < h + SP; gy += SP) {
            var dx = gx - cx, dy = gy - cy, d2 = dx * dx + dy * dy, px = gx, py = gy;
            if (d2 < r2 && d2 > 0) {
              var d = Math.sqrt(d2), f = FORCE * (1 - d / REPEL);
              px += (dx / d) * f; py += (dy / d) * f;
            }
            ctx.moveTo(px + R, py);
            ctx.arc(px, py, R, 0, Math.PI * 2);
          }
        }
        ctx.fill();
        requestAnimationFrame(draw);
      }
      window.addEventListener('resize', resize);
      resize();
      requestAnimationFrame(draw);
    }

    // Cursor
    var cur = document.querySelector('.cursor');
    if (cur && fine) {
      var tx = 0, ty = 0, x = 0, y = 0, shown = false;
      document.addEventListener('mousemove', function (e) {
        tx = e.clientX; ty = e.clientY;
        if (!shown) { x = tx; y = ty; shown = true; cur.style.opacity = '1'; }
      });
      (function tick() {
        x += (tx - x) * 0.35; y += (ty - y) * 0.35;
        cur.style.left = x + 'px'; cur.style.top = y + 'px';
        requestAnimationFrame(tick);
      })();
      document.addEventListener('mouseover', function (e) {
        if (e.target.closest('a, button, label, input, select, textarea')) cur.classList.add('hover');
      });
      document.addEventListener('mouseout', function (e) {
        if (e.target.closest('a, button, label, input, select, textarea')) cur.classList.remove('hover');
      });
      document.addEventListener('mouseleave', function () { cur.style.opacity = '0'; });
      document.addEventListener('mouseenter', function () { cur.style.opacity = '1'; });
    }
  })();
</script>
