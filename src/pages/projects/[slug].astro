---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const related = (
  await getCollection('projects', (p) => p.id !== project.id && p.data.category === d.category)
).slice(0, 3);
const facts: [string, string | undefined][] = [
  ['Client', d.client],
  ['Designer', d.designer],
  ['Location', d.location],
  ['Year', String(d.year)],
  ['Type', d.category],
  ['Our scope', d.scope.join(', ') || undefined],
  ['Collaborators', d.collaborators.join(', ') || undefined],
  ['Materials', d.materials.join(', ') || undefined],
];
const description = d.summary ?? `${d.title}, ${d.category.toLowerCase()} by Chinchilla Design, ${d.year}.`;
const isWide = (img?: ImageMetadata) => !!img && img.width / img.height > 1.25;
// With a model, the hero photo joins the gallery; without one, it leads the page instead of the orbit view.
const gallery = d.model ? [{ image: d.hero, caption: d.heroAlt }, ...d.gallery] : d.gallery;
---
<Base title={d.title} description={description} ogImage={d.hero} models={!!d.model}>
  <article class="section" style="padding-top:clamp(8px,2vw,24px)">
    <div class="wrap">
      <div class="proj">
        <div class="proj-view">
          {d.model ? (
            <>
              <model-viewer
                class="proj-mv"
                src={d.model}
                alt={d.heroAlt}
                auto-rotate
                auto-rotate-delay="0"
                rotation-per-second="12deg"
                camera-controls
                touch-action="pan-y"
                interaction-prompt="auto"
                shadow-intensity="0.6"
                environment-image="neutral"
                exposure="1"
                camera-orbit="45deg 65deg auto"
                loading="eager"
              ></model-viewer>
              <span class="hint">Drag to orbit · scroll to zoom</span>
            </>
          ) : (
            <Image src={d.hero} alt={d.heroAlt} widths={[800, 1200, 1800]} sizes="(min-width: 960px) 58vw, 100vw" loading="eager" />
          )}
        </div>

        <div class="proj-panel">
          <p class="eyebrow">{d.category}</p>
          <h1>{d.title}</h1>
          <dl class="facts">
            {facts.filter(([, v]) => v).map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          </dl>
          <div class="story"><Content /></div>

          {gallery.length > 0 && (
            <div class="gallery">
              {gallery.map((g) => (
                <figure class={isWide(g.image) || g.video ? 'wide' : undefined}>
                  {g.image && (
                    <Image src={g.image} alt={g.caption} widths={[600, 900, 1400]} sizes="(min-width: 960px) 40vw, 100vw" />
                  )}
                  {g.video && <video controls preload="none" playsinline src={g.video}></video>}
                  <figcaption>{g.caption}</figcaption>
                </figure>
              ))}
            </div>
          )}

          {d.press.length > 0 && (
            <div class="press">
              <p class="eyebrow">Press</p>
              <ul>{d.press.map((p) => <li><a href={p.url} rel="noopener" target="_blank">{p.title}</a></li>)}</ul>
            </div>
          )}

          <p style="margin-top:40px"><a class="btn" href="/#library">Back to the objects</a></p>
        </div>
      </div>

      {related.length > 0 && (
        <div class="related">
          <p class="eyebrow">Related</p>
          <div class="grid cols-3">{related.map((p) => <ProjectCard project={p} />)}</div>
        </div>
      )}
    </div>
  </article>
</Base>
