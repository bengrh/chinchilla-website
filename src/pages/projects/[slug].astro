---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const related = (
  await getCollection('projects', (p) => p.id !== project.id && p.data.category === d.category)
).slice(0, 2);
const facts: [string, string | undefined][] = [
  ['Client', d.client],
  ['Designer', d.designer],
  ['Location', d.location],
  ['Year', String(d.year)],
  ['Type', d.category],
  ['Our scope', d.scope.join(', ') || undefined],
  ['Collaborators', d.collaborators.join(', ') || undefined],
  ['Materials', d.materials.join(', ') || undefined],
];
const description = d.summary ?? `${d.title}, ${d.category.toLowerCase()} by Chinchilla Design, ${d.year}.`;
const isWide = (img?: ImageMetadata) => !!img && img.width / img.height > 1.25;
---
<Base title={d.title} description={description} ogImage={d.hero}>
  <article>
    <header class="project-top">
      <div class="wrap">
        <p class="eyebrow">{d.category}</p>
        <h1 class="split" aria-label={d.title}>
          {d.title.split(' ').map((w, i, arr) => (
            <><span class="w">{[...w].map((c, j) => <span class="ch" style={`animation-delay:${(0.1 + 0.02 * (i * 6 + j)).toFixed(2)}s`}>{c}</span>)}</span>{i < arr.length - 1 ? ' ' : ''}</>
          ))}
        </h1>
        {d.summary && <p class="lede fade-up">{d.summary}</p>}
      </div>
    </header>

    <div class="wrap">
      <div class="band">
        <Image src={d.hero} alt={d.heroAlt} widths={[800, 1200, 1800, 2400]} sizes="(min-width: 1320px) 1320px, 100vw" loading="eager" />
      </div>

      <div class="project-head">
        <dl class="facts">
          {facts.filter(([, v]) => v).map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
        <div class="story"><Content /></div>
      </div>

      {d.gallery.length > 0 && (
        <div class="gallery">
          {d.gallery.map((g) => (
            <figure class={isWide(g.image) || g.video ? 'wide' : undefined}>
              {g.image && (
                <Image src={g.image} alt={g.caption} widths={[700, 1100, 1800]} sizes="(min-width: 1320px) 1320px, 100vw" />
              )}
              {g.video && <video controls preload="none" playsinline src={g.video}></video>}
              <figcaption>{g.caption}</figcaption>
            </figure>
          ))}
        </div>
      )}

      {d.press.length > 0 && (
        <div class="press">
          <p class="eyebrow">Press</p>
          <ul>{d.press.map((p) => <li><a href={p.url} rel="noopener" target="_blank">{p.title}</a></li>)}</ul>
        </div>
      )}

      {related.length > 0 && (
        <div class="related">
          <p class="eyebrow">More {d.category.toLowerCase()}</p>
          <div class="grid cols-2">{related.map((p) => <ProjectCard project={p} />)}</div>
        </div>
      )}
      <p style="margin-top:clamp(40px,5vw,64px)"><a class="btn" href="/projects">All projects</a></p>
    </div>
  </article>
</Base>
