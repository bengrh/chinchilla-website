---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import band from '../content/projects/singing-hollow/glow-wide.jpg';

const featured = (await getCollection('projects', (p) => p.data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const different = [
  ['A new language in wood', 'Parametric design and CNC are not a faster way to make the same things. They are a way to make different things.'],
  ['In from the first concept', 'Material, fabrication logic and real feasibility while the idea is still forming, not after it is locked.'],
  ['One studio, sketch to install', 'The person who understood the idea is the person building it. Nothing is lost in a handoff.'],
];
---
<Base title="Chinchilla Design">
  <!-- Old single-page anchors (#projects, #about, #contact) map to the new pages. -->
  <script is:inline>
    (function () {
      var m = { '#projects': '/projects', '#work': '/projects', '#services': '/process', '#about': '/studio', '#team': '/studio', '#contact': '/contact' };
      var to = m[location.hash.toLowerCase()];
      if (to) location.replace(to);
    })();
  </script>

  <section class="hero">
    <div class="wrap">
      <h1>We design and build things in wood you didn't know were possible.</h1>
      <p class="lede">A Vancouver design and fabrication studio that helps architects, designers and clients take on complex projects in wood. We develop ambitious ideas with you from the first sketch, then build them ourselves.</p>
      <a class="btn" href="/process">How we work</a>
    </div>
  </section>

  <figure class="band" style="margin:0">
    <Image src={band} alt="Singing Hollow: the tiled cedar surface funnelling inward to the lit hollow" widths={[800, 1200, 1616]} sizes="100vw" loading="eager" />
    <figcaption>Singing Hollow, IDS West 2026</figcaption>
  </figure>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Selected work</p>
      <div class="grid cols-3 editorial">
        {featured.map((p, i) => <ProjectCard project={p} eager={i < 3} />)}
      </div>
      <p style="margin-top:clamp(48px,6vw,88px)"><a class="btn" href="/projects">All projects</a></p>
    </div>
  </section>

  <hr class="rule" />

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">How we are different</p>
      <p class="statement">A design partner, <em>not just a fabricator.</em> The earlier we are in, the more of the idea survives contact with material, budget and schedule.</p>
      <div class="three" style="margin-top:clamp(32px,4vw,56px)">
        {different.map(([h, p]) => <div><h3>{h}</h3><p>{p}</p></div>)}
      </div>
      <p style="margin-top:clamp(32px,4vw,56px)"><a class="btn" href="/process">Read how a project runs</a></p>
    </div>
  </section>

  <hr class="rule" />

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Bring us in early</p>
      <h2 style="max-width:18ch">You can picture the piece. We can help you build it.</h2>
      <a class="btn" href="/contact">Start a conversation</a>
    </div>
  </section>
</Base>
